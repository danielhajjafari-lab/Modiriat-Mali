
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="مدیریت مالی"
        android:supportsRtl="true"
        android:theme="@style/Theme.ModiriatMali.Starting">

        <activity
            android:name=".MainActivity"
            android:exported="true" />

        <activity-alias
            android:name=".WalletIcon"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_wallet"
            android:label="مدیریت مالی">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ChartIcon"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            @mipmap/ic_launcher_chart
            android:label="مدیریت مالی">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".CoinIcon"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="مدیریت مالی">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".BankIcon"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            @mipmap/ic_launcher_bank
            android:label="مدیریت مالی">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".SavingsIcon"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            @mipmap/ic_launcher_savings
            android:label="مدیریت مالی">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ReceiptIcon"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            @mipmap/ic_launcher_receipt
            android:label="مدیریت مالی">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".CalculatorIcon"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            @mipmap/ic_launcher_calculator
            android:label="مدیریت مالی">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".CardIcon"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
          @mipmap/ic_launcher_card
            android:label="مدیریت مالی">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

    </application>
</manifest>
